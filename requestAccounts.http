@baseUrl = http://localhost:5221

POST {{baseUrl}}/api/accounts
Accept: application/json
Content-Type: application/json

{
  "InstitutionId": "01A1EEE1-D028-702B-9879-BBD8125977C2",
  "AccountNumber": "123456789",
  "Currency": "USD"
}

### with same institution, differentt currency
POST {{baseUrl}}/api/accounts
Accept: application/json
Content-Type: application/json

{
  "InstitutionId": "01A1EEE1-D028-702B-9879-BBD8125977C2",
  "AccountNumber": "987654321",
  "Currency": "COP"
}

### inexistent intitution
POST {{baseUrl}}/api/accounts
Accept: application/json
Content-Type: application/json

{
  "InstitutionId": "3f2504e0-4f89-false-9a0c-0305e82c3301",
  "AccountNumber": "123456789",
  "Currency": "USD",
}

### get 
GET {{baseUrl}}/api/accounts/3f2504e0-4f89-11d3-9a0c-0305e82c3301
Accept: application/json